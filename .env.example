# FITIQ — environment variables (copy to .env; never commit .env)

# Server-side Groq API key. Used ONLY by the Vite middleware, Node server and
# Vercel functions for /api/recommend (metadata only) and
# /api/detect-garment (consented photo → Groq Vision, qwen/qwen3.8-27b).
# Never sent to the browser, never bundled.
GROQ_API_KEY=

# Client-side provider switch:
#   "groq" -> use the server-side Groq route (with local mock fallback)
#   anything else / unset -> local mock only
VITE_RECOMMEND_PROVIDER=groq

# Optional cloud sync. Guest mode works without these. Only the
# publishable/anon key may be used in the browser — never a secret or
# service-role key. See supabase/README.md for the one-time schema setup.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
